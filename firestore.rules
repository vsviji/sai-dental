rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ─── Helper: check role ─── */
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role == 'admin';
    }
    function isStaff() {
      return request.auth != null
        && (get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role == 'staff'
          || get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role == 'admin');
    }
    function isDoctor() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role == 'doctor';
    }

    /* ─── Prescriptions ─── */
    match /prescriptions/{rxId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.id == rxId;
      allow update: if request.auth != null;
      allow delete: if isAdmin();
    }

    /* ─── Patients (keyed by mobile) ─── */
    match /patients/{mobile} {
      allow read: if request.auth != null;
      allow create: if (isAdmin() || isStaff() || isDoctor()) && request.resource.data.mobile == mobile;
      allow update: if isAdmin() || isStaff() || isDoctor();
      allow delete: if isAdmin();
    }

    /* ─── Follow-ups ─── */
    match /followups/{fupId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    /* ─── Settings ─── */
    match /settings/{key} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || ((isStaff() || isDoctor()) && key.matches('tokenCounter_.*'));
    }

    /* ─── Users (role assignments) ─── */
    match /users/{email} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    /* ─── Appointments ─── */
    match /appointments/{aptId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    /* ─── Inventory ─── */
    match /inventory/{invId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    /* ─── Daily patient tokens ─── */
    match /tokens/{tokenId} {
      allow read: if request.auth != null;
      allow create: if isStaff() || isDoctor() || isAdmin();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }
  }
}
