rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ─── Helper: check role ─── */
    function hasRole(role) {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role == role;
    }
    function isAdmin() {
      return hasRole('admin');
    }
    function isStaff() {
      return hasRole('staff') || isAdmin();
    }
    function isOnlyStaff() {
      return hasRole('staff');
    }
    function isDoctor() {
      return hasRole('doctor');
    }
    function isAuthorized() {
      return isStaff() || isDoctor();
    }

    /* ─── Prescriptions ─── */
    match /prescriptions/{rxId} {
      allow read: if isAuthorized();
      allow create: if (isAdmin() || isDoctor()) && request.resource.data.id == rxId;
      allow update: if isAdmin() || isDoctor() || (
        isOnlyStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['patientName', 'patientOPNo', 'patientRef', 'patientAge', 'patientGender', 'patientContact', 'medicineFee', 'grand', 'paid', 'paymentStatus', 'paymentMethod'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['medicineFee', 'grand'])
          || (
            request.resource.data.medicineFee is number
            && request.resource.data.medicineFee >= 0
            && request.resource.data.grand is number
            && request.resource.data.grand == request.resource.data.medicineFee + resource.data.get('treatmentFee', 0)
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['paid', 'paymentStatus', 'paymentMethod'])
          || (
            request.resource.data.paid is number
            && request.resource.data.paid == request.resource.data.grand
            && request.resource.data.paymentStatus == 'paid'
            && request.resource.data.paymentMethod in ['cash', 'gpay', 'bpay']
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['patientAge'])
          || !resource.data.keys().hasAny(['patientAge'])
          || resource.data.patientAge == null
          || resource.data.patientAge == ''
          || request.resource.data.patientAge == resource.data.patientAge
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['patientGender'])
          || !resource.data.keys().hasAny(['patientGender'])
          || resource.data.patientGender == null
          || resource.data.patientGender == ''
          || request.resource.data.patientGender == resource.data.patientGender
        )
      );
      allow delete: if isAdmin() || isDoctor();
    }

    /* ─── Patients (keyed by mobile) ─── */
    match /patients/{mobile} {
      allow read: if isAuthorized();
      allow create: if (isAdmin() || isStaff() || isDoctor()) && request.resource.data.mobile == mobile;
      allow update: if isAdmin() || isStaff() || isDoctor();
      allow delete: if isAdmin();
    }

    /* ─── Follow-ups ─── */
    match /followups/{fupId} {
      allow read, write: if isStaff();
    }

    /* ─── Settings ─── */
    match /settings/{key} {
      allow read: if isAuthorized();
      allow write: if isAdmin() || ((isStaff() || isDoctor()) && key.matches('tokenCounter_.*'));
    }

    /* ─── Users (role assignments) ─── */
    match /users/{email} {
      allow get: if isAdmin() || (
        request.auth != null
        && request.auth.token.email != null
        && email == request.auth.token.email.lower()
      );
      allow list: if isAdmin() || (
        request.auth != null
        && request.auth.token.email != null
        && resource.data.email == request.auth.token.email.lower()
      );
      allow write: if isAdmin();
    }

    /* ─── Appointments ─── */
    match /appointments/{aptId} {
      allow read, write: if isStaff();
    }

    /* ─── Inventory ─── */
    match /inventory/{invId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    /* ─── Daily patient tokens ─── */
    match /tokens/{tokenId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }
  }
}
