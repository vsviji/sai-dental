rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ─── Helper: check role ─── */
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin';
    }
    function isStaff() {
      let role = get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role;
      return role == 'staff' || role == 'admin';
    }

    /* ─── Prescriptions ─── */
    match /prescriptions/{rxId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.id == rxId;
      allow update: if request.auth != null;
      allow delete: if isAdmin();
    }

    /* ─── Patients (keyed by mobile) ─── */
    match /patients/{mobile} {
      allow read: if request.auth != null;
      allow create: if isAdmin() && request.resource.data.mobile == mobile;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ─── Follow-ups ─── */
    match /followups/{fupId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    /* ─── Settings ─── */
    match /settings/{key} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    /* ─── Users (role assignments) ─── */
    match /users/{email} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    /* ─── Appointments ─── */
    match /appointments/{aptId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    /* ─── Inventory ─── */
    match /inventory/{invId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
