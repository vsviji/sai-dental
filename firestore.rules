rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ─── Helper: check role ─── */
    function hasRole(role) {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role == role;
    }
    function isAdmin() {
      return hasRole('admin');
    }
    function isStaff() {
      return hasRole('staff') || isAdmin();
    }
    function isDoctor() {
      return hasRole('doctor');
    }
    function isAuthorized() {
      return isStaff() || isDoctor();
    }

    /* ─── Prescriptions ─── */
    match /prescriptions/{rxId} {
      allow read: if isAuthorized();
      allow create: if (isAdmin() || isDoctor()) && request.resource.data.id == rxId;
      allow update: if isAdmin() || isDoctor();
      allow delete: if isAdmin() || isDoctor();
    }

    /* ─── Patients (keyed by mobile) ─── */
    match /patients/{mobile} {
      allow read: if isAuthorized();
      allow create: if (isAdmin() || isStaff() || isDoctor()) && request.resource.data.mobile == mobile;
      allow update: if isAdmin() || isStaff() || isDoctor();
      allow delete: if isAdmin();
    }

    /* ─── Follow-ups ─── */
    match /followups/{fupId} {
      allow read, write: if isStaff();
    }

    /* ─── Settings ─── */
    match /settings/{key} {
      allow read: if isAuthorized();
      allow write: if isAdmin() || ((isStaff() || isDoctor()) && key.matches('tokenCounter_.*'));
    }

    /* ─── Users (role assignments) ─── */
    match /users/{email} {
      allow get: if isAdmin() || (
        request.auth != null
        && request.auth.token.email != null
        && email == request.auth.token.email.lower()
      );
      allow list: if isAdmin() || (
        request.auth != null
        && request.auth.token.email != null
        && resource.data.email == request.auth.token.email.lower()
      );
      allow write: if isAdmin();
    }

    /* ─── Appointments ─── */
    match /appointments/{aptId} {
      allow read, write: if isStaff();
    }

    /* ─── Inventory ─── */
    match /inventory/{invId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    /* ─── Daily patient tokens ─── */
    match /tokens/{tokenId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }
  }
}
