rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function hasRole(role) {
      return request.auth != null
        && request.auth.token.email != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.token.email.lower()))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.token.email.lower())).data.role == role;
    }
    function isAuthorized() {
      return hasRole('admin') || hasRole('doctor') || hasRole('staff');
    }
    function isAdmin() {
      return hasRole('admin');
    }

    match /xrays/{rxId}/{fileName} {
      allow read: if isAuthorized();
      allow write: if request.auth != null && isAdmin();
    }
  }
}
